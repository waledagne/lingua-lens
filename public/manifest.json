{
  "manifest_version": 3,
  "name": "Lingua Lens",
  "version": "0.3.1",
  "description": "Automatically detect website languages and translate pages and dialogs into your chosen language, locally in Chrome.",
  "minimum_chrome_version": "138",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Lingua Lens"},
  "options_page": "setup.html"
}
