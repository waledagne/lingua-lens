{
  "name": "lingua-lens",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Continuous website translation between your chosen languages in Chrome.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "browser:prepare": "node --import tsx scripts/prepare-browser.ts",
    "browser:doctor": "npm run build && node --import tsx scripts/browser-doctor.ts",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
